groupId=cool.klass
artifactId=klass
display=${groupId}:${artifactId}
version=0.7.0

gitRepo=https://github.com/liftwizard/${artifactId}.git
gitTag=${version}

tool=mvn-3.9.12
jdk=21
newline=lf
umask=022

command="mvn -T 1 -Pdeploy clean verify -DskipTests -Dmaven.javadoc.skip -Dgpg.skip"
buildinfo=target/${artifactId}-${version}.buildinfo

