groupId=org.glassfish.hk2
artifactId=hk2-parent
version=4.0.2

display=${groupId}:${artifactId}

gitRepo=https://github.com/eclipse-ee4j/glassfish-hk2.git
gitTag=${version}

tool=mvn-3.9.12
jdk=21
newline=lf
umask=022

command="mvn -Poss-release clean package -DskipTests -Dmaven.javadoc.skip -Dgpg.skip -DskipSBOM -pl !hk2-testing/di-tck"
execBefore="find . -type d -exec chmod g+s {} \; && sed -i -e 's/2026-04-28T21:36:23Z/2026-08-17T17:04:50Z/' -e 's/HEAD/4.0.2/' project/pom.xml"

buildinfo=target/${artifactId}-${version}.buildinfo

#diffoscope=${artifactId}-${version}.diffoscope
issue=

