# https://reproducible-builds.org/docs/jvm/
buildinfo.version=1.0-SNAPSHOT

name=JPMML-Converter
group-id=org.jpmml
artifact-id=jpmml-converter
version=1.6.11

# source information
source.scm.uri=scm:git:git@github.com:jpmml/jpmml-converter.git
source.scm.tag=1.6.11

# build instructions
build-tool=mvn

# effective build environment information
java.version=17.0.20.1
java.vendor=Ubuntu
os.name=Linux
os.version=6.17.0-1022-azure
