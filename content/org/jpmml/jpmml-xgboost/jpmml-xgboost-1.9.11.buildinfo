# https://reproducible-builds.org/docs/jvm/
buildinfo.version=1.0-SNAPSHOT

name=JPMML-XGBoost
group-id=org.jpmml
artifact-id=jpmml-xgboost
version=1.9.11

# source information
source.scm.uri=scm:git:git@github.com:jpmml/jpmml-xgboost.git
source.scm.tag=1.9.11

# build instructions
build-tool=mvn

# effective build environment information
java.version=17.0.20.1
java.vendor=Ubuntu
os.name=Linux
os.version=6.17.0-1022-azure
os.arch=amd64
line.separator=\n

# Maven rebuild instructions and effective environment
mvn.version=3.9.11
mvn.rebuild-args=-Dmaven.session.versionFilter=e(com.fasterxml.jackson.core:jackson-annotations:(2.22,));e(org.apache.commons:commons-math3:(3.6.1,));e(com.google.code.gson:gson:(2.14.0,));e(com.fasterxml.jackson.core:jackson-annotations:(2.22,));e(com.google.code.gson:gson:(2.14.0,))
mvn.aggregate.artifact-id=pmml-xgboost-example

