# https://reproducible-builds.org/docs/jvm/
buildinfo.version=1.0-SNAPSHOT

name=JPMML-StatsModels
group-id=org.jpmml
artifact-id=jpmml-statsmodels
version=1.3.14

# source information
source.scm.uri=scm:git:git@github.com:jpmml/jpmml-statsmodels.git
source.scm.tag=1.3.14

# build instructions
build-tool=mvn

# effective build environment information
java.version=17.0.20.1
java.vendor=Ubuntu
os.name=Linux
os.version=7.0.0-1017-azure
os.arch=amd64
line.separator=\n

# Maven rebuild instructions and effective environment
mvn.version=3.9.12
mvn.rebuild-args=-Dmaven.session.versionFilter=e(com.fasterxml.jackson.core:jackson-annotations:(2.22,));e(org.apache.commons:commons-math3:(3.6.1,));e(com.fasterxml.jackson.core:jackson-annotations:(2.22,))
mvn.aggregate.artifact-id=pmml-statsmodels-example

