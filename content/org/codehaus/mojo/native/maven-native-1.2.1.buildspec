groupId=org.codehaus.mojo
artifactId=native-maven-plugin
display=${groupId}:${artifactId}
version=1.2.1

gitRepo=https://github.com/mojohaus/maven-native.git
gitTag=${version}

tool=mvn-3.9.12
jdk=25
newline=lf
umask=022

command="mvn -Pmojo-release clean package -DskipTests -Dmaven.javadoc.skip -Dgpg.skip"
buildinfo=target/maven-native-${version}.buildinfo

issue=
