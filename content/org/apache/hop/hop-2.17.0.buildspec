groupId=org.apache.hop
artifactId=hop
display=${groupId}:${artifactId}
version=2.17.0

gitRepo=https://github.com/apache/hop.git
gitTag=${version}-rc1

tool=mvn-3.9.12
jdk=17
newline=lf
umask=022

command="mvn -Papache-release -P=-assemblies clean package -DskipTests -Dmaven.javadoc.skip -Dgpg.skip -Dassemblies=false"

buildinfo=target/${artifactId}-${version}.buildinfo

#diffoscope=${artifactId}-${version}.diffoscope
issue=
