groupId=org.apache.shiro
artifactId=shiro-root
display=${groupId}:${artifactId}
version=3.0.2

gitRepo=https://github.com/apache/shiro.git
gitTag=${artifactId}-${version}

tool=mvn-3.10.0
jdk=25
newline=lf
umask=022
timezone="America/Chicago"

command="mvn -Papache-release clean package -DskipTests -Dmaven.javadoc.skip -Dgpg.skip -Dmaven.test.skip -Dmaven.consumer.pom.flatten -pl '!integration-tests,!samples'"

buildinfo=target/${artifactId}-${version}.buildinfo

#diffoscope=${artifactId}-${version}.diffoscope
issue=
