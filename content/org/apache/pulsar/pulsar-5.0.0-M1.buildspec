groupId=org.apache.pulsar
artifactId=pulsar
display=${groupId}:${artifactId}
version=5.0.0-M1

gitRepo=https://github.com/apache/pulsar.git
gitTag=v${version}

tool=gradle
jdk=21
newline=lf
umask=022

# release process https://pulsar.apache.org/contribute/release-process/
command="./gradlew clean assemble -x test --no-daemon --no-build-cache publishToMavenLocal"
buildinfo=${artifactId}-${version}.buildinfo

#diffoscope=${artifactId}-${version}.diffoscope
issue=
