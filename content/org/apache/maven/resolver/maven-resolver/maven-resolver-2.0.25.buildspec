groupId=org.apache.maven.resolver
artifactId=maven-resolver
display=${groupId}:${artifactId}
version=2.0.25

gitRepo=https://github.com/apache/${artifactId}.git
gitTag=${artifactId}-${version}

tool=mvn-3.9.12
jdk=25
newline=lf
umask=022
# for example in META-INF/DEPENDENCIES of maven-resolver-test-http-$version.jar: Brotli4j (https://github.com/hyperxpro/Brotli4j/natives/native-linux-x86_64) com.aayushatharva.brotli4j:native-linux-x86_64:jar
os=osx
arch=aarch64

command="mvn -Papache-release clean package -DskipTests -Dmaven.javadoc.skip -Dgpg.skip -Drat.skip"
buildinfo=target/${artifactId}-${version}.buildinfo

#diffoscope=${artifactId}-${version}.diffoscope
issue=
