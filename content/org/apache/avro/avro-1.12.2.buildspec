groupId=org.apache.avro
artifactId=avro-toplevel
display=${groupId}:${artifactId}
version=1.12.2

gitRepo=https://github.com/apache/avro.git
gitTag=release-${version}

tool=mvn-3.9.12
jdk=21
toolchains="17|21|24"
newline=lf

command="mvn -Pdist clean verify -DskipTests -Dmaven.javadoc.skip -Dgpg.skip -Dbuildinfo.ignore='*/*-tests.jar,*/*-test-resource.jar'"
buildinfo=target/${artifactId}-${version}.buildinfo

issue=
