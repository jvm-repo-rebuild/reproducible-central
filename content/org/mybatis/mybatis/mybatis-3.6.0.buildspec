groupId=org.mybatis
artifactId=mybatis
version=3.6.0

display=${groupId}:${artifactId}

gitRepo=https://github.com/mybatis/mybatis-3.git
gitTag=${artifactId}-${version}

tool=mvn-3.9.16
jdk=27
newline=lf
newlineGit=crlf
#umask=022

command="mvn -Prelease clean package -DskipTests -Dmaven.javadoc.skip -Dgpg.skip -Drewrite.skip -Dformatter.skip -Dwhitespace.skip -Dimpsort.skip"
buildinfo=target/${artifactId}-${version}.buildinfo

#diffoscope=${artifactId}-${version}.diffoscope
issue=
