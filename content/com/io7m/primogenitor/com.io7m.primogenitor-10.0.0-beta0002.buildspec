groupId=com.io7m.primogenitor
artifactId=com.io7m.primogenitor
display=com.io7m.*:*.$(echo $artifactId | cut -c 10-)
version=10.0.0-beta0002

gitRepo="https://codeberg.org/io7m-com/$(echo "${artifactId}" | sed s/com.io7m.//)"
gitTag=${artifactId}-${version}

tool=mvn-3.9.12
jdk=25
newline=lf
umask=022

command="mvn -Dio7m.api.previousVersion=0.0.0 -DskipTests clean package"
buildinfo=target/${artifactId}-${version}.buildinfo

#diffoscope=${artifactId}-${version}.diffoscope
issue=
