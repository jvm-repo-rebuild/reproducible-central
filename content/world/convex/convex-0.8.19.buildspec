groupId=world.convex
artifactId=convex
version=0.8.19

display=${groupId}:${artifactId}

gitRepo=https://github.com/Convex-Dev/${artifactId}.git
gitTag=${version}

tool=mvn-3.9.12
jdk=27
newline=lf

command="mvn -Prelease clean verify -DskipTests -Dmaven.javadoc.skip -Dgpg.skip -pl !convex-integration"

buildinfo=target/${artifactId}-${version}.buildinfo

#diffoscope=${artifactId}-${version}.diffoscope
issue=
PR_merge_max_ko=2
