groupId=io.avaje
artifactId=avaje-prisms-parent
display=${groupId}:$(echo "${artifactId}" | sed -e "s/-parent//")
version=2.2

gitRepo=https://github.com/avaje/avaje-prisms.git
gitTag=${version}
#gitTag="git log --all --pretty=format:%H --grep '$version'"

tool=mvn-3.9.12
jdk=26
newline=lf
#umask=022

command="mvn -Pcentral clean package -DskipTests -Dmaven.javadoc.skip -Dgpg.skip -pl '!blackbox-test-prism'"
buildinfo=target/${artifactId}-${version}.buildinfo

#diffoscope=${artifactId}-${version}.diffoscope
issue=
