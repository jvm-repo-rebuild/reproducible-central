# Central Repository coordinates for the Reference release (multi-module: the parent POM)
groupId=io.github.brunopacheco1
artifactId=praecepta
version=0.2.0

display=${groupId}:${artifactId}

# Source code
gitRepo=https://github.com/brunopacheco1/praecepta.git
gitTag=v${version}

# Rebuild environment prerequisites
tool=mvn-3.9.12
jdk=25
newline=lf

# The tag keeps the development version: the release workflow sets the version and the
# build timestamp (mvn versions:set) before deploying, so apply the same two edits here
execBefore="perl -pi -e 's|<version>0\.2\.0-SNAPSHOT</version>|<version>0.2.0</version>|; s|<project\.build\.outputTimestamp>[^<]*<|<project.build.outputTimestamp>2026-11-08T20:08:06Z<|' pom.xml */pom.xml"

# Rebuild command: the published modules only, as the release workflow deploys them
command="mvn -Prelease clean package -pl praecepta-engine,praecepta-loader,praecepta-maven-plugin -am -DskipTests -Dinvoker.skip -Dgpg.skip"

# Location of the buildinfo file generated during rebuild (by artifact:compare for Maven) to record output fingerprints
buildinfo=target/${artifactId}-${version}.buildinfo

issue=
