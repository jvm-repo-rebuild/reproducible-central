groupId=io.telicent.jena
artifactId=rdf-abac
display=${groupId}:${artifactId}
version=3.1.5

gitRepo=https://github.com/telicent-oss/rdf-abac
gitTag=${version}

tool=mvn-3.9.12
jdk=21
newline=lf
#umask=022

command="mvn clean package -DskipTests -Dmaven.javadoc.skip -Dgpg.skip -Dbuildinfo.skipModules='*/*-server,*/*-benchmark,*/*-report'"
buildinfo=target/${artifactId}-${version}.buildinfo

